<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>MadNegar.ico</ApplicationIcon>
    <AssemblyName>MadNegar</AssemblyName>
    <RootNamespace>MadNegar</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <AssemblyTitle>MadNegar</AssemblyTitle>
    <Product>MadNegar</Product>
    <Authors>MadNegar Project</Authors>
    <Description>Small offline Persian and English voice typing app for Windows with live transcription preview, WASAPI capture and microphone processing.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The standalone text-normalizer test harness compiles its own linked source and must not enter the app build. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="FasterWhisperAdapter.py" LogicalName="MadNegar.FasterWhisperAdapter.py" />
  </ItemGroup>
</Project>
